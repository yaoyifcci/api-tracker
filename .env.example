# Copy this file to .env and fill in your keys.
# .env is gitignored and never committed.
#
# Environment variables have the highest priority and override both
# config.yaml and config.local.yaml.

# Which endpoint to use for /v1/* requests (must match a name in config.yaml)
# AITRACE_DEFAULT_ENDPOINT=jdcloud

# Per-endpoint keys  (name → uppercase, hyphens → underscores)
AITRACE_ENDPOINT_JDCLOUD_KEY=your_jdcloud_key_here
AITRACE_ENDPOINT_OPENAI_KEY=sk-...
AITRACE_ENDPOINT_OPENAI_RESPONSES_KEY=sk-...
AITRACE_ENDPOINT_ANTHROPIC_KEY=sk-ant-...

# Optional: third-party services using Anthropic protocol
# AITRACE_ENDPOINT_ROUTEANY_KEY=sk-...

# Optional infrastructure overrides
# AITRACE_PROXY_PORT=8080
# AITRACE_MONGO_URI=mongodb://localhost:27017
# AITRACE_MONGO_DB=aitrace
