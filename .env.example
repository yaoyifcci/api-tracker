# Copy this file to .env and fill in your keys.
# .env is gitignored and never committed.
#
# Environment variables have the highest priority and override both
# config.yaml and config.local.yaml.

# Which endpoint to use for /v1/* requests (must match a name in config.yaml)
# APITRACKER_DEFAULT_ENDPOINT=openai

# Per-endpoint keys  (name → uppercase, hyphens → underscores)
APITRACKER_ENDPOINT_OPENAI_KEY=sk-...
APITRACKER_ENDPOINT_OPENAI_RESPONSES_KEY=sk-...
APITRACKER_ENDPOINT_ANTHROPIC_KEY=sk-ant-...

# Optional infrastructure overrides
# APITRACKER_PROXY_PORT=8080
# APITRACKER_MONGO_URI=mongodb://localhost:27017
# APITRACKER_MONGO_DB=api-tracker
